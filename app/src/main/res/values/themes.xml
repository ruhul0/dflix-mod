<resources>
    <style name="Theme.DflixTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="PlayerButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/player_button_text</item>
        <item name="android:background">@drawable/player_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
